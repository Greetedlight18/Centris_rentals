# ---------- Database ----------
POSTGRES_USER=rentals
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rentals
DB_PORT=5432

# ---------- Application ports (host side) ----------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- Frontend / Backend wiring ----------
# URL the BROWSER uses to reach the API (must be reachable from your machine)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed by the backend CORS policy (comma separated)
CORS_ORIGINS=http://localhost:3000

# ---------- Proximity rule ----------
# 15-minute walk at ~80 m/min = 1200 m straight-line distance
WALK_RADIUS_METERS=1200

# ---------- Scraper ----------
SCRAPE_INTERVAL_HOURS=6
SCRAPE_MAX_PAGES=20
SCRAPE_HEADLESS=true
SCRAPE_MIN_DELAY_SECONDS=2
SCRAPE_MAX_DELAY_SECONDS=6
RUN_ON_STARTUP=true
SCRAPE_START_URL=https://www.centris.ca/en/properties~for-rent?uc=0
# Optional proxy, e.g. http://user:pass@host:port (leave empty for none)
SCRAPE_PROXY=